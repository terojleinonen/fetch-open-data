{
  "name": "stephen-king-universe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "pnpm run build && node --test tests/release.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "enrich:google-books": "node --env-file=.env.local scripts/enrich-google-books.mjs",
    "enrich:tmdb": "node --env-file=.env.local scripts/enrich-screen-tmdb.mjs"
    ,"research:index": "node scripts/build-research-index.mjs",
    "audit:covers": "node scripts/audit-openlibrary-covers.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
